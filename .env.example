# Copy this file to ".env" (same folder) and replace the placeholder values.
# The .env file is ignored by git and must never be committed or shared.

# Required: your Seats.aero Pro Partner API key (Settings -> API on seats.aero)
SEATS_AERO_API_KEY=replace_with_your_key

# Header scheme. "bearer" sends "Partner-Authorization: Bearer <key>" (default).
# Set to "raw" if the connection test reports that the bearer form is rejected.
SEATS_AERO_AUTH_SCHEME=bearer

# Where the local SQLite database lives
DATABASE_PATH=data/awards.sqlite

# Display timezone for the dashboard (timestamps are stored in UTC)
TIMEZONE=America/Los_Angeles

# Daily API call budget this app is allowed to spend (Seats.aero Pro quota is 1000/day, UTC reset)
API_DAILY_BUDGET=800

# Optional alerting. Leave blank to disable.
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Notifications -------------------------------------------------------
# Mac notification banners are ON by default when the scan runs on a Mac. Set to 0 to turn off.
ALERT_MACOS_NOTIFICATIONS=1
# Free push alerts to your phone: install the "ntfy" app, pick a hard-to-guess topic name,
# subscribe to it in the app, and put the same name here. Leave blank to disable.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Optional: cash-fare comparison (cents per point) via the free Amadeus developer API ---------
# Sign up at https://developers.amadeus.com, create an app, paste its key and secret here.
# AMADEUS_ENV=test uses the free sandbox (limited airline data); production needs a one-time app approval.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test
